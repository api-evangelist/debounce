        {
          "name": "Validate Single Email Address",
          "id": "471a3333-31bd-4307-8f93-cf52327d0d9f",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/?api=<string>&email=<email>&photo=<boolean>&append=<boolean>&gsuite=<boolean>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                ""
              ],
              "query": [
                {
                  "description": "(Required) Your DeBounce API key",
                  "key": "api",
                  "value": "<string>"
                },
                {
                  "description": "(Required) The email address to validate",
                  "key": "email",
                  "value": "<email>"
                },
                {
                  "description": "If true, returns a profile photo URL (additional credits apply)",
                  "key": "photo",
                  "value": "<boolean>"
                },
                {
                  "description": "If true, enriches response with full name and avatar (additional credits apply)",
                  "key": "append",
                  "value": "<boolean>"
                },
                {
                  "description": "If true, detects G Suite accept-all emails",
                  "key": "gsuite",
                  "value": "<boolean>"
                }
              ]
            },
            "description": "Validates a single email address and returns detailed validation results including deliverability status, disposable detection, role-based detection, free email provider detection, and optional data enrichment. Up to 5 concurrent calls are supported.\n"
          },
